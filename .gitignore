# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/output

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# figma cache (development artifact) — track extraction docs only
/figma-cache/
/docs/figma-cache/screenshots/
/docs/figma-cache/assets/
/docs/figma-cache/raw/

# sanity
.sanity/
src/sanity/extract.json

# development artifacts
/tmp/
/audit-reports/
.playwright-mcp/
.playwright-cli/
*.fig
figma-extract/

# git worktrees
/.worktrees

# migration snapshots (write-once rollback refs, not source-of-truth)
/scripts/migrate/*-snapshot.json
/scripts/migrate/*-draft.json

# Claude Code worktrees (stale merged branch copy; keep out of lint/tailwind scans)
/.claude/worktrees/

# iCloud Drive never syncs *.nosync — node_modules/.next live there via symlink (Desktop is iCloud-synced)
*.nosync
*.trash-old

# .next is a symlink locally (iCloud workaround); match it as a file too
.next
node_modules
scripts/media/out/
